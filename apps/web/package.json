{
  "name": "@matt-alison-wedding/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run images:check && npm run images:generate && tsc -p tsconfig.json && vite build",
    "dev": "vite",
    "images:check": "node scripts/check-responsive-images-untracked.mjs",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "predev": "npm run images:generate",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-table": "^9.1.2",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "sharp": "^0.35.3",
    "vite": "^8.2.1"
  }
}
